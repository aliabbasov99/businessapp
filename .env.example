# Generated securely by npm run db:start. Never prefix credentials with EXPO_PUBLIC_.
DATABASE_ADMIN_URL=postgresql://dashboard_owner:replace_me@127.0.0.1:5432/dashboard
DATABASE_URL=postgresql://dashboard_app:replace_me@127.0.0.1:5432/dashboard
# Explicitly enables the existing demo user's API locally. Not a production login.
LOCAL_DEMO_API=true
# Optional API origin for a standalone native build (use your computer's LAN IP).
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8081
